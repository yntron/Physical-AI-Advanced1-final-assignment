<?xml version="1.0"?>
<!--
  メインのワールド: ロボットの 5m 前方に「人」を立たせる。
  人のモデルは Gazebo Fuel（公開モデル置き場）から初回起動時に自動ダウンロードされる。
-->
<sdf version="1.9">
  <world name="safety_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- カメラを動かすためのセンサーシステム -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ロボット -->
    <include>
      <uri>model://pai_robot</uri>
      <name>pai_robot</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 人（Gazebo 公式サンプル actor.sdf と同じ人物モデル）。
         初回起動時に Gazebo Fuel から自動ダウンロードされる。
         yaw=-1.57 でロボットの方を向いて、その場で話す動きをする -->
    <actor name="person">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/talk_b.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="talk_b">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/talk_b.dae</filename>
        <scale>0.055</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="talk_b">
          <waypoint>
            <time>0</time>
            <pose>5 0 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>5 0 1.0 0 0 -1.57</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- 景色用の障害物（検出対象ではない） -->
    <model name="box_red">
      <static>true</static>
      <pose>3 2 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      </link>
    </model>
    <model name="box_green">
      <static>true</static>
      <pose>2 -2 0.25 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
